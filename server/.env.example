PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL (Docker locally; Neon/Supabase in prod)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=fairnest_dev_pw
PG_DATABASE=mynest
# Set PG_SSL=true on hosted Postgres (Neon/Render) that requires TLS
PG_SSL=false

# Frontend origin for CORS (prod only)
CLIENT_URL=http://localhost:5173

# --- Email (password-reset OTPs) ---
# If omitted, OTPs are logged to console + server/otp.log + dev_otp response (local dev only).
# In production set these to actually send email via Nodemailer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=myNest <no-reply@mynest.in>

# Google Places (optional, for scripts/fetch-real-pgs.js)
GOOGLE_PLACES_KEY=
